{
    "name": "thomas-institut/timestring",
    "type": "library",
    "description": "A class to deal with MySQL datetime strings with microseconds",
    "keywords": ["data"],
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Rafael Nájera",
            "email": "rafael.najera@uni-koeln.de"
        }
    ],
    "scripts": {
        "test" : "php vendor/bin/phpunit test/",
        "phpstan": "php vendor/bin/phpstan analyze TimeString test",
        "test:coverage": "php -dxdebug.coverage_enable=1 -dxdebug.mode=coverage vendor/bin/phpunit --coverage-html coverage --coverage-filter TimeString test/"
    },
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.6.2"
    },
    "autoload": {
        "psr-4": {
            "ThomasInstitut\\TimeString\\": "TimeString"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ThomasInstitut\\TimeString\\": "test"
        }
    }
}
